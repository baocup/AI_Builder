# 统一换行符，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto eol=lf

*.java       text eol=lf
*.gradle     text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.toml       text eol=lf
*.py         text eol=lf
*.properties text eol=lf

gradlew      text eol=lf
gradlew.bat  text eol=crlf

# 二进制文件不做换行转换
*.png  binary
*.jar  binary
*.dll  binary
*.lib  binary
*.gz   binary
